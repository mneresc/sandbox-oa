{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandboxRecipe",
  "type": "object",
  "required": ["id", "version", "component", "runtime"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "component": {
      "type": "object",
      "required": ["id", "repository", "entrypoint"],
      "properties": {
        "id": { "type": "string" },
        "repository": { "type": "string" },
        "entrypoint": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["timeoutMs"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "memoryMb": { "type": "integer", "minimum": 64 }
      }
    }
  }
}
